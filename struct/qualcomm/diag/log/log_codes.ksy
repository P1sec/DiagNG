meta:
  id: diag_logging

# From https://github.com/P1sec/QCSuper/blob/2.1.1/src/qcsuper/protocol/log_types.py

enums:
  log_masks_readable:
    0xf000: equipment_id_mask
    0xfc00: subcategory_mask

  log_masks_qcdm:
    0xf000: equipment_id_mask
    0x0fff: item_id_mask

  equipment_id:
    0x0: log_oem
    0x1: log_1x
    0x4: log_wcdma
    0x5: log_gsm
    0x6: log_lbs
