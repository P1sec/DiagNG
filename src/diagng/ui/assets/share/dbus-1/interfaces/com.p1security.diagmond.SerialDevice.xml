<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node>
    <interface name="org.freedesktop.DBus.Introspectable">
        <method name="Introspect">
            <arg name="data" type="s" direction="out" />
        </method>
    </interface>

    <!--
        com.p1security.diagmond.SerialDevice:

        A serial port device exposed through the `diagmond` daemon.
    -->
    <interface name="com.p1security.diagmond.SerialDevice">
        <!--
            Read:
            @data: Data read from the serial port

            Emitted when data has been received
            from the serial port
        -->
        <signal name="Read">
            <arg type="ay" name="data" direction="out" />
        </signal>

        <!--
            Closed:
            @reason: Plaintext reason for which the
              serial port was closed

            Emitted when the serial port got unavailable,
            which also means that the current D-Bus object
            will be unregistered very soon
        -->
        <signal name="Closed">
            <arg type="s" name="reason" direction="out" />
        </signal>

        <!--
            Write:
            @data: Data to write to the serial port

            Perform a single write operation over the
            given serial port.
        -->
        <method name="Write">
            <arg type="ay" name="data" direction="in" />
        </method>

        <!--
            Close:

            Close the serial port
        -->
        <method name="Close" />

    </interface>
</node>


