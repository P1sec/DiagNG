using Gtk 4.0;
using Adw 1;

template $ADBDeviceRow: Adw.ExpanderRow {
  expanded: true;
  title-selectable: true;

  Adw.ExpanderRow {
    expanded: true;
    title: "Automatic diag port setup";

    [suffix]
    Button {
      label: "Trigger";

      styles [
        "pill",
        "suggested-action",
      ]
    }

    Adw.ActionRow {
      title: "Step 1";

      Label {
        attributes: "0 -1 weight bold, 0 -1 foreground #a4a400000000";
        label: "Failed";
      }
    }
  }

  Adw.ActionRow {
    title: "adbd status";

    Button {
      label: "Restart as root";

      styles [
        "pill",
      ]
    }

    Button {
      label: "Restart as TCP/IP";

      styles [
        "pill",
      ]
    }
  }

  Adw.ActionRow {
    title: "Root availability status";

    Adw.Spinner {}
  }

  Adw.ActionRow {
    title: "Diag availability status";

    Label {
      label: "Loading...";
    }
  }

  Adw.ActionRow {
    title: "Current USB mode";

    Label {
      label: "Loading...";
    }
  }

  Adw.ActionRow {
    title: "Suggested USB mode";

    Label {
      label: "Loading...";
    }
  }

  Adw.ExpanderRow {
    title: "Action 2 (test root using su?)";

    [suffix]
    Button {
      label: "Trigger";

      styles [
        "pill",
      ]
    }
  }

  Adw.ExpanderRow {
    title: "Action 3 (switch on Xiaomi QC Diag?)";

    [suffix]
    Button {
      label: "Trigger";

      styles [
        "pill",
      ]
    }
  }

  Adw.ExpanderRow {
    title: "Action 4 (dial *#0808# for Samsung QC?)";

    [suffix]
    Button {
      label: "Trigger";

      styles [
        "pill",
      ]
    }
  }

  Adw.ExpanderRow {
    title: "Action 5 (dial *#8011# for Oneplus QC?)";

    [suffix]
    Button {
      label: "Trigger";

      styles [
        "pill",
      ]
    }
  }
}
