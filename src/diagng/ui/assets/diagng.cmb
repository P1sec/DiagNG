<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<!DOCTYPE cambalache-project SYSTEM "cambalache-project.dtd">
<!-- Created with Cambalache 1.2.0 -->
<cambalache-project version="1.0.0" target_tk="gtk-4.0" depends="libadwaita-1">
  <gresources filename="diagng.gresource.xml"/>
  <css priority="600" is_global="1" filename="style.css"/>
  <ui template-class="ADBDeviceRow" filename="templates/main_window/adb_device_row.blp"/>
  <ui template-class="GtkListItem" filename="templates/main_window/udev_serial_tree_factory.blp">
    <property id="accessible-description" type-id="gchararray"/>
    <property id="accessible-label" type-id="gchararray" translatable="1"/>
    <property id="activatable" type-id="gboolean" default-value="True"/>
    <property id="child" type-id="GtkWidget" is-object="1"/>
    <property id="focusable" type-id="gboolean" default-value="True"/>
    <property id="selectable" type-id="gboolean" default-value="True"/>
  </ui>
  <ui template-class="GtkListItem" filename="templates/main_window/nusb_tree_factory.blp">
    <property id="accessible-description" type-id="gchararray"/>
    <property id="accessible-label" type-id="gchararray" translatable="1"/>
    <property id="activatable" type-id="gboolean" default-value="True"/>
    <property id="child" type-id="GtkWidget" is-object="1"/>
    <property id="focusable" type-id="gboolean" default-value="True"/>
    <property id="selectable" type-id="gboolean" default-value="True"/>
  </ui>
  <ui template-class="QCDMWindow" filename="templates/qcdm_window/window.blp"/>
  <ui template-class="AuthorizationDialog" filename="templates/authorization_dialog/window.blp"/>
  <ui template-class="APKSelectWindow" filename="templates/main_window/mi_apk_chooser.blp"/>
  <ui template-class="MainWindow" filename="templates/main_window/window.blp">
    <requires>ADBDeviceRow</requires>
    <css-provider>style.css</css-provider>
  </ui>
</cambalache-project>
