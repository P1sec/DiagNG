<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
    <interface name="org.freedesktop.DBus.Introspectable">
        <method name="Introspect">
            <arg name="data" type="s" direction="out" />
        </method>
    </interface>

    <interface name="com.p1security.diagmond">
        <doc:doc>
            <doc:description>
                <doc:para>
                    The background, privileged, single-instance
                    Rust/Tokio service handling raw USB/SPI, USB,
                    Diag frag acquisition, providing IPC.
                </doc:para>
            </doc:description>
        </doc:doc>

        <!-- ***************************************************************** -->
        <signal name="USBDataUpdated">
            <doc:doc>
                <doc:description>
                    <doc:para>
                        Triggered when nusb-related metadata is changed.
                        Contains the values of the up-to-date metadata.
                    </doc:para>
                </doc:description>
            </doc:doc>
            <arg type="s" name="USBData" direction="out" />
        </signal>

        <!-- ***************************************************************** -->
        <property name="USBData" type="s" access="read">
            <doc:doc>
                <doc:description>
                    <doc:para>
                        USB status information, using the
                        JSON structure laid out in
                        <doc:tt>diagmond::system::usb_devices::UsbDevicesEndpointResp</doc:tt>
                    </doc:para>
                </doc:description>
            </doc:doc>
        </property>

        <!-- ***************************************************************** -->
        <signal name="UDevRulesUpdated">
            <doc:doc>
                <doc:description>
                    <doc:para>
                        Triggered when runtimes rules contained in
                        /run/udev/rules.d on the host system are
                        changed.
                    </doc:para>
                </doc:description>
            </doc:doc>
            <arg type="s" name="UDevRules" direction="out" />
        </signal>

        <!-- ***************************************************************** -->
        <property name="UDevRules" type="s" access="read">
            <doc:doc>
                <doc:description>
                    <doc:para>
                        Runtime UDev rules information, using the
                        JSON structure laid out in
                        <doc:tt>diagmond::system::udev_rules::UDevRuleList</doc:tt>
                    </doc:para>
                </doc:description>
            </doc:doc>
        </property>

        <!--*********************************************************************-->
        <method name="LockMMDeviceUDev">
            <arg type="s" name="full_name" direction="in">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            The full /dev name of the ModemManager device to lock
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
            <arg type="s" name="kernel_name" direction="in">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            The UDev KERNEL name of the ModemManager device to lock
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
            <arg type="b" name="success" direction="out">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            Result of the operation
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
        </method>

        <!--*********************************************************************-->
        <method name="ReleaseMMDeviceUDev">
            <arg type="s" name="full_name" direction="in">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            The full /dev name of the ModemManager device to release
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
            <arg type="s" name="kernel_name" direction="in">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            The UDev KERNEL name of the ModemManager device to release
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
            <arg type="b" name="success" direction="out">
                <doc:doc>
                    <doc:summary>
                        <doc:para>
                            Result of the operation
                        </doc:para>
                    </doc:summary>
                </doc:doc>
            </arg>
        </method>

