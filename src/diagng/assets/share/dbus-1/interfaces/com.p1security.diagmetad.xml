<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
    "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node>
    <interface name="org.freedesktop.DBus.Introspectable">
        <method name="Introspect">
            <arg name="data" type="s" direction="out" />
        </method>
    </interface>

    <!--
        com.p1security.diagmetad:

        The background, unprivileged, single-instance
        Python3/GObject service handling on Linux ModemManager
        communication, UDev data acquisition, providing IPC.
    -->
    <interface name="com.p1security.diagmetad">
        <!--
            MMInfoUpdated:

            Triggered when ModemManager-related properties were changed.
            Contains the values of the up-to-date given properties.
        -->
        <signal name="MMInfoUpdated">
            <arg type="a{sv}" name="MMStatusInfo" direction="out" />
            <arg type="s" name="MMDebugInfo" direction="out" />
        </signal>

        <!--
            UDevInfoUpdated:

            Triggered when UDev-related properties were changed.
            Contains the values of the up-to-date given properties.
        -->
        <signal name="UDevInfoUpdated">
            <arg type="aa{sv}" name="UDevUSBDeviceTree" direction="out" />
            <arg type="aa{sv}" name="UDevSPIDeviceTree" direction="out" />
            <arg type="aa{sv}" name="SPIDeviceInformation" direction="out" />
            <arg type="s" name="UDevUSBDebugInfo" direction="out" />
        </signal>

        <!--
            MMDebugInfo:

            ModemManager debug information, JSON-formatted.
        -->
        <property name="MMDebugInfo" type="s" access="read" />

        <!--
            MMStatusInfo:

            ModemManager status information, using the
            format laid out in
            #diagng.gobject.mm_instance.ModemManagerInstance
        -->
        <property name="MMStatusInfo" type="a{sv}" access="read" />

        <!--
            UDevUSBDebugInfo:

            UDev USB device debug information, JSON-formatted.
        -->
        <property name="UDevUSBDebugInfo" type="s" access="read" />

        <!--
            UDevUSBDeviceTree:

            UDev USB device tree information, using the
            format laid out in
            #diagng.gobject.udev_device.UDevDevice
        -->
        <property name="UDevUSBDeviceTree" type="aa{sv}" access="read" />

        <!--
            UDevSPIDeviceTree:

            UDev USB device tree information, using the
            format laid out in
            #diagng.gobject.udev_device.UDevDevice ,
            SPI-related devices only
        -->
        <property name="UDevSPIDeviceTree" type="aa{sv}" access="read" />

        <!--
            SPIDeviceInformation:

            TTY serial port device tree information, using the
            format laid out in
            #diagng.gobject.serial_port.SerialPort ,
            extracted from UDev SPI information
        -->
        <property name="SPIDeviceInformation" type="aa{sv}" access="read" />
    </interface>
</node>

