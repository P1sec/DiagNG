<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>P1 Security</vendor>
  <vendor_url>https://www.p1sec.com/</vendor_url>
  <icon_name>com.p1security.diagng</icon_name>
  <action id="com.p1security.diagmond.capture-serial-port">
    <description>Open a raw serial port connection</description>
    <message>Authentication is required to open a raw serial port connection.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
